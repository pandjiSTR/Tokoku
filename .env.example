# Supabase > Project Settings > API
NEXT_PUBLIC_SUPABASE_URL=https://xxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Supabase > Database > Connection string (Transaction pooler, port 6543)
DATABASE_URL=postgresql://postgres.xxxx:PASSWORD@aws-0-xx.pooler.supabase.com:6543/postgres
# Supabase > Project Settings > API > service_role (RAHASIA, hanya di server; jangan di-commit)
SUPABASE_SERVICE_ROLE_KEY=
# Notifikasi email (opsional). Contoh Gmail: smtp.gmail.com, port 587, kata sandi aplikasi.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
# Alamat publik aplikasi, dipakai untuk tautan di email, mis. http://34.136.234.3
APP_URL=
# Rahasia pekerjaan terjadwal (kedaluwarsa pesanan). Isi string acak panjang. Hanya dipakai di secret app-env.
CRON_SECRET=
# true hanya jika aplikasi berada di belakang Caddy (HTTPS). Mengaktifkan pembatasan laju per IP.
TRUST_PROXY=false
